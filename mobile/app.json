{
  "expo": {
    "name": "availy",
    "slug": "availy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakındaki kampanyaları göstermek için konumunu kullanırız."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Sadakat damgası vermek için müşterinin QR kodunu okutmak üzere kamerayı kullanırız."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Rehberindeki arkadaşlarını availy'de bulmak için telefon numaralarına bakarız; rehberin saklanmaz."
        }
      ],
      "expo-font",
      "expo-status-bar"
    ]
  }
}
