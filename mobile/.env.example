# Mac'in yerel ağ IP'si (telefon aynı Wi-Fi'da olmalı). Bulmak için: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.1.17:8000

# "Google ile devam et": Google Cloud > APIs & Services > Credentials > OAuth client ID (one per platform).
# Not secret. Empty: the Google button stays hidden. See docs/social-sign-in.md
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# The Android store build's map (Google Maps). Expo Go does not need it. Set it in EAS (eas env), not in git;
# restrict it in Google Cloud to the app's package name and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
